{
  "name": "ryvo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest __tests__/domain --config vitest.config.ts",
    "test:components": "vitest __tests__/components --config vitest.config.ts",
    "test:integration": "node -e \"console.log('Foundation only: integration tests are deferred until the PostgreSQL milestone.')\"",
    "test:e2e": "playwright test",
    "pr-check:quick": "npm run typecheck && npm run lint && npm run build && npm run test:unit -- --run && npm run test:components -- --run && npm run test:e2e -- --project=chromium"
  },
  "dependencies": {
    "@fontsource-variable/hubot-sans": "5.3.0",
    "@fontsource-variable/kalnia": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "gsap": "3.15.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
